 "documentation": [
  {
   "uuid": "273d0c5c-bbf2-4914-879e-47d8ecd627f3",
   "title": "Design",
   "type": "design",
   "created": "2026-10-21T13:42:48.162Z",
   "value": "The CDS in the Light-Responsive Expression Module is replaceable, so the same light-controlled circuit can be used to produce any protectant a user chooses. The module includes an mScarlet-I reporter, which lets users verify and characterize the light response of the circuit. The exchange uses BsaI: a Level 1 construct carrying the desired output module can be inserted directly in place of the existing cassette, while the promoter and regulatory elements stay unchanged. The protectant is then expressed under the same green/red light control in the Optogenetic Circuit, so users can adapt the system to their own needs without rebuilding the circuit.",
   "lastEditedBy": "Sophie Chen",
   "authorUUID": "8de7ff3d-7d8b-42ed-a284-c454c5534c3c",
   "organisationUUID": "3f22886d-da0b-4a5a-8711-7b14b020c9de",
